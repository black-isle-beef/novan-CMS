{
  "ci": {
    "collect": {
      "startServerCommand": "node --env-file=apps/starter-site/.env.serve --env-file=apps/starter-site/.env.lighthouse dist/apps/starter-site/server/server.mjs",
      "startServerReadyPattern": "listening on",
      "startServerReadyTimeout": 60000,
      "url": ["http://localhost:4000/", "http://localhost:4000/about", "http://localhost:4000/contact"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "dist/.lighthouseci"
    }
  }
}
