{
  "name": "cms-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/cms-angular/src",
  "prefix": "novan",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:site", "type:data", "publishable"],
  "targets": {
    "check-readme": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^default"],
      "outputs": [],
      "options": {
        "commands": ["node libs/cms-angular/tools/check-readme.mjs", "ngc -p libs/cms-angular/tsconfig.examples.json"],
        "parallel": false
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "dependsOn": ["^build", "check-readme"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/cms-angular/ng-package.json",
        "tsConfig": "libs/cms-angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/cms-angular/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    }
  }
}
