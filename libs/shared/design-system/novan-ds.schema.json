                                    ],
                                    "additionalProperties": false
                                  }
                                ]
                              }
                            },
                            "required": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^[a-z][a-zA-Z0-9]*$"
                              }
                            }
                          },
                          "required": [
                            "type",
