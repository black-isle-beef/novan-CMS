{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "framework": {
      "type": "string",
      "enum": [
        "css",
        "tailwind",
        "bootstrap",
        "web-components"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "css": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200,
        "pattern": "^(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
      }
    },
    "js": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200,
        "pattern": "^(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
      }
    },
    "allowedOrigins": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "classGroups": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-:/.[\\]#%()!,@]{1,120}$"
        }
      }
    },
    "breakpoints": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg",
          "xl"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "states": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "hover",
          "focus",
          "active",
          "dark"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "tokens": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^--[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "default": "text",
            "type": "string",
            "enum": [
              "color",
              "length",
              "number",
              "text"
            ]
          },
          "default": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "default": [],
