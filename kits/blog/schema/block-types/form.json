{
  "apiId": "form",
  "name": "Form",
  "icon": "ui-checks",
  "previewImagePath": null,
  "fields": [
    {
      "id": "heading",
      "apiId": "heading",
      "label": "Heading",
      "required": false,
      "localised": true,
      "type": "text",
      "multiline": false,
      "max": 120
    },
    {
      "id": "intro",
      "apiId": "intro",
      "label": "Introduction",
      "required": false,
      "localised": true,
      "type": "text",
      "multiline": true,
      "max": 300
    },
    {
      "id": "fields",
      "apiId": "fields",
      "label": "Fields",
      "required": true,
      "localised": false,
