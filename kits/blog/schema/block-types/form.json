      "multiple": true,
      "min": 1,
      "max": 20,
      "fields": [
        {
          "id": "label",
          "apiId": "label",
          "label": "Label",
          "required": true,
          "localised": true,
          "type": "text",
          "multiline": false,
          "max": 200
        },
        {
          "id": "name",
          "apiId": "name",
          "label": "Name in the inbox",
