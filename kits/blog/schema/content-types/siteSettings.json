{
  "apiId": "siteSettings",
  "name": "Site settings",
  "kind": "singleton",
  "description": "The site's name, look in browsers and search results, and how to get in touch.",
  "fields": [
    {
      "id": "siteName",
      "apiId": "siteName",
      "label": "Site name",
      "help": "Shown in the header and in browser tabs.",
      "required": true,
      "localised": true,
      "type": "text",
      "multiline": false,
      "max": 60
    },
    {
      "id": "organisationName",
      "apiId": "organisationName",
      "label": "Organisation name",
      "help": "Shown in the copyright line, and to search engines as who runs the site.",
      "required": true,
      "localised": false,
      "type": "text",
      "multiline": false,
      "max": 120
    },
    {
      "id": "logo",
      "apiId": "logo",
      "label": "Logo",
      "help": "Shown in the header instead of the site name. An SVG or a wide PNG works best.",
      "required": false,
      "localised": false,
      "type": "media",
      "accept": [
        "image"
      ],
      "multiple": false,
      "requireAlt": false
    },
    {
      "id": "favicon",
      "apiId": "favicon",
      "label": "Browser tab icon",
      "help": "A square image, at least 48 by 48 pixels: a PNG or an SVG.",
      "required": false,
      "localised": false,
      "type": "media",
      "accept": [
        "image"
      ],
      "multiple": false,
      "requireAlt": false
    },
    {
      "id": "defaultOgImage",
      "apiId": "defaultOgImage",
      "label": "Sharing image",
      "help": "Shown when a page without its own sharing image is shared on social media. 1200 by 630 pixels works best.",
      "required": false,
      "localised": false,
      "type": "media",
      "accept": [
        "image"
      ],
      "multiple": false,
      "requireAlt": true
    },
    {
      "id": "contact",
      "apiId": "contact",
      "label": "Contact details",
      "help": "Shown in the footer, and to search engines.",
      "required": false,
      "localised": false,
      "type": "group",
      "multiple": false,
      "fields": [
        {
          "id": "email",
          "apiId": "email",
          "label": "Email address",
          "required": false,
          "localised": false,
          "type": "text",
          "multiline": false,
          "max": 254,
          "pattern": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+"
        },
        {
          "id": "phone",
          "apiId": "phone",
          "label": "Phone number",
          "required": false,
          "localised": false,
          "type": "text",
          "multiline": false,
          "max": 40,
          "pattern": "\\+?[0-9 ()-]{6,40}"
        },
        {
          "id": "address",
          "apiId": "address",
          "label": "Postal address",
          "required": false,
          "localised": false,
          "type": "text",
          "multiline": true,
          "max": 300
        }
      ]
    },
    {
      "id": "socialLinks",
      "apiId": "socialLinks",
      "label": "Social media",
      "help": "Your profiles, shown in the footer.",
      "required": false,
      "localised": false,
      "type": "group",
      "multiple": true,
      "max": 10,
      "fields": [
        {
          "id": "network",
          "apiId": "network",
          "label": "Network",
          "required": true,
          "localised": false,
          "type": "select",
          "options": [
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "linkedin",
              "label": "LinkedIn"
            },
            {
              "value": "x",
              "label": "X"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "multiple": false
        },
        {
          "id": "url",
          "apiId": "url",
          "label": "Profile address",
          "required": true,
          "localised": false,
          "type": "text",
          "multiline": false,
          "max": 2048,
          "pattern": "https://\\S+"
        }
      ]
    },
    {
      "id": "analyticsId",
      "apiId": "analyticsId",
      "label": "Google Analytics measurement ID",
      "help": "Starts G-, for example G-ABC123XYZ. Leave empty for no analytics.",
      "required": false,
      "localised": false,
      "type": "text",
      "multiline": false,
      "max": 20,
      "pattern": "G-[A-Z0-9]{4,16}"
    }
  ]
}
