                "type": "email",
                "required": true,
                "help": "We only use it to reply to you."
              },
              {
                "label": "Message",
                "name": "message",
                "type": "textarea",
                "required": true
              },
              {
                "label": "I agree that you may keep my message to reply to it.",
                "name": "consent",
                "type": "consent",
                "required": true
              }
            ],
