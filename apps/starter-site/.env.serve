# Loaded by Nx for `nx serve starter-site` only (local development and the e2e tests).
# The delivery and preview tokens supabase/seed.sql creates for the demo space: public, and useless outside a local
# database.
# To use other tokens, set NOVAN_DELIVERY_TOKEN or NOVAN_PREVIEW_TOKEN in your shell or in apps/starter-site/.env.serve.local
# (git-ignored), which Nx reads before this file.
NOVAN_DELIVERY_TOKEN=nv_del_LocalStarterSiteDeliveryTokenSeedOnly000000
NOVAN_PREVIEW_TOKEN=nv_pre_LocalStarterSitePreviewTokenSeedOnly0000000
