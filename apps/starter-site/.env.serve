# Loaded by Nx for `nx serve starter-site` only (local development and the e2e tests).
# The delivery token supabase/seed.sql creates for the demo space: public, and useless outside a local database.
# To use another token, set NOVAN_DELIVERY_TOKEN in your shell or in apps/starter-site/.env.serve.local
# (git-ignored), which Nx reads before this file.
NOVAN_DELIVERY_TOKEN=nv_del_LocalStarterSiteDeliveryTokenSeedOnly000000
