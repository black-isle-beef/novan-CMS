# The API as api-e2e runs it (`nx run api:serve-e2e`), on top of .env.local. Nothing secret: cache purges go
# to the fake Cloudflare API the e2e global setup starts (src/support/fake-cloudflare.ts).
CLOUDFLARE_ZONE_ID=e2e-zone
CLOUDFLARE_API_TOKEN=e2e-token
CLOUDFLARE_API_URL=http://127.0.0.1:54399/client/v4
PUBLIC_API_URL=http://localhost:3000
