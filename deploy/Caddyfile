# The host's only public entry point (package 20). Cloudflare proxies every host name (DNS records orange-clouded,
# SSL mode "Full (strict)"); Caddy ends TLS with Cloudflare origin certificates and passes requests to the containers.
# Host names come from .env, which the deploy workflow writes.
{
	# Origin certificates, not ACME: Cloudflare's proxy sits in front of every name.
	auto_https disable_redirects
	servers {
		# Cloudflare's edge, so X-Forwarded-For keeps the visitor's address (the API's rate limits and form checks
		# read it). From https://www.cloudflare.com/ips/; check it when rotating secrets (docs/ops/rotate-secrets.md).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
	}
}

(common) {
	encode zstd gzip
	log {
		output stdout
		format json
	}
	header -Server
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# Platform: *.{$NOVAN_DOMAIN} origin certificate.
(platform_tls) {
	tls /etc/caddy/certs/{$NOVAN_DOMAIN}.pem /etc/caddy/certs/{$NOVAN_DOMAIN}.key
}

{$API_HOST} {
	import common
	import platform_tls
	reverse_proxy api:3000
}

{$ADMIN_HOST} {
	import common
	import platform_tls
	reverse_proxy admin:8080
}

# The Novan CMS marketing site (apps/web). A www. name, so the platform's wildcard origin certificate covers it; send
# the bare domain to it with a Cloudflare redirect rule (docs/clients/marketing-site.md).
{$MARKETING_HOST} {
	import common
	import platform_tls
	reverse_proxy web:4000
}

# --- Client sites ---------------------------------------------------------------------------------------------------
# One block per site (docs/ops/add-client-domain.md). A client domain in its own Cloudflare zone has its own origin
# certificate, named after the zone.

{$STARTER_SITE_HOST} {
	import common
	import platform_tls
	reverse_proxy starter-site:4000
}
