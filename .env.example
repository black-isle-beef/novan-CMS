# Novan CMS environment variables.
#
# Local: copy to .env.local (never committed) and fill the keys from
#   npx supabase status -o env
# after `npm run db:start`. URLs and ports below are the local Supabase defaults.
# Staging and production values live in the deployment secrets (package 20), never in git.

# --- Database (API only) ------------------------------------------------------
# Direct Postgres connection used by Drizzle. `supabase status`: DB_URL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase -----------------------------------------------------------------
# `supabase status`: API_URL
SUPABASE_URL=http://127.0.0.1:54321
# Public key, safe for the admin. `supabase status`: ANON_KEY
SUPABASE_ANON_KEY=
# Bypasses RLS. API server environment ONLY: never the admin, SDK or a client site.
# `supabase status`: SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=
# Verifies Supabase access tokens in the API. Set one of the two:
# symmetric secret (`supabase status`: JWT_SECRET) ...
SUPABASE_JWT_SECRET=
# ... or the JWKS endpoint for asymmetric signing keys.
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Resize images on the API's image route (`/v1/assets/:id/:filename?width=...`) with Supabase image
# transformations. They need the Supabase Pro plan, so leave this off locally and on free plans: the
# original image is served instead. API only.
SUPABASE_IMAGE_TRANSFORMS=false

# --- Delivery API (package 08, API only) ---------------------------------------
# The API's public address, used in delivered file URLs (`<PUBLIC_API_URL>/v1/assets/<id>/<file>`).
# Defaults to http://localhost:<API_PORT>.
PUBLIC_API_URL=http://localhost:3000
# Cloudflare cache purging on publish. Leave the zone empty locally: purging is then skipped.
# The token needs the Zone > Cache Purge permission for this zone only.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Requests a second per API token (defaults 50 and 10). Raise them only for load tests.
# DELIVERY_RATE_LIMIT=50
# PREVIEW_RATE_LIMIT=10

# --- Client sites (package 09, site server only) --------------------------------
# Read by the site's Node server (apps/starter-site/src/novan.server.ts), never sent to the browser.
# Create the tokens in the admin: Settings > API tokens.
# The API as the site's server reaches it.
NOVAN_API_URL=http://localhost:3000
# Delivery token (nv_del_...): published content. Locally, `npm run db:reset` seeds this one for the demo
# space (supabase/seed.sql); it is public and works only against a local database.
NOVAN_DELIVERY_TOKEN=nv_del_LocalStarterSiteDeliveryTokenSeedOnly000000
# Preview token (nv_pre_...): drafts, for previews from the admin. Leave empty to turn preview off.
NOVAN_PREVIEW_TOKEN=
# The site's public address, used in sitemap.xml and robots.txt, and the host the server renders for
# (package 10). Required in production; locally the request's own address is used.
# SITE_URL=https://www.example.com
# Further host names the server may answer for, comma-separated (e.g. a staging host). Angular reads it too.
# NG_ALLOWED_HOSTS=

# --- Apps ---------------------------------------------------------------------
API_PORT=3000
# Admin origin: auth redirects (supabase/config.toml site_url), invite links and API CORS.
ADMIN_URL=http://localhost:4200

# --- Tests --------------------------------------------------------------------
# Local inbox the admin e2e tests read invite emails from. `supabase status`: MAILPIT_URL
# MAILPIT_URL=http://127.0.0.1:54324
