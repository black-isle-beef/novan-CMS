{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@novan/shared-types": ["./libs/shared/types/src/index.ts"],
      "@novan/shared-schemas": ["./libs/shared/schemas/src/index.ts"],
      "@black-isle-beef/cms-angular": ["./libs/cms-angular/src/index.ts"],
      "@black-isle-beef/cms-angular/bridge": ["./libs/cms-angular/bridge/src/index.ts"],
      "@black-isle-beef/cms-angular/server": ["./libs/cms-angular/server/src/index.ts"],
      "@novan/blocks": ["./libs/blocks/src/index.ts"],
      "@novan/api-db": ["./libs/api/db/src/index.ts"],
      "@novan/api-auth": ["./libs/api/auth/src/index.ts"],
      "@novan/api-spaces": ["./libs/api/spaces/src/index.ts"],
      "@novan/api-site": ["./libs/api/site/src/index.ts"],
      "@novan/api-common": ["./libs/api/common/src/index.ts"],
      "@novan/api-content-model": ["./libs/api/content-model/src/index.ts"],
      "@novan/api-content": ["./libs/api/content/src/index.ts"],
      "@novan/api-media": ["./libs/api/media/src/index.ts"],
      "@novan/admin-auth": ["./libs/admin/auth/src/index.ts"],
      "@novan/admin-content": ["./libs/admin/content/src/index.ts"],
      "@novan/admin-dashboard": ["./libs/admin/dashboard/src/index.ts"],
      "@novan/admin-editor": ["./libs/admin/editor/src/index.ts"],
      "@novan/admin-fields": ["./libs/admin/fields/src/index.ts"],
      "@novan/admin-media": ["./libs/admin/media/src/index.ts"],
      "@novan/admin-schema": ["./libs/admin/schema/src/index.ts"],
      "@novan/admin-settings": ["./libs/admin/settings/src/index.ts"],
      "@novan/admin-shell": ["./libs/admin/shell/src/index.ts"],
      "@novan/admin-spaces": ["./libs/admin/spaces/src/index.ts"],
      "@novan/api-delivery": ["./libs/api/delivery/src/index.ts"]
